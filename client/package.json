{
  "name": "@stockflow/client",
  "version": "1.0.3",
  "description": "StockFlow Desktop Application",
  "main": "main/main.js",
  "author": "Manthan Movaliya",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manthan29-code/StockFlow.git"
  },
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "dist": "electron-builder --win",
    "dist:publish": "node -r dotenv/config ./node_modules/electron-builder/cli.js --win -p always"
  },
  "build": {
    "appId": "com.stockflow.app",
    "productName": "StockFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "Manthan29-code",
        "repo": "StockFlow",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "**/*",
      "!test/**",
      "!src/**"
    ]
  },
  "dependencies": {
    "@stockflow/shared": "file:../shared",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "electron-updater": "^6.3.9",
    "exceljs": "^4.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vitest": "^5.1.0"
  }
}
