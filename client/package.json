{
  "name": "@stockflow/client",
  "version": "1.0.0",
  "description": "StockFlow Desktop Application",
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.stockflow.app",
    "productName": "StockFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@stockflow/shared": "file:../shared",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vitest": "^5.1.0"
  }
}
