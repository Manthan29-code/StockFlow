# Default server address shown on the login screen (user can change it in the app)
API_BASE_URL=http://localhost:3000
# Used when the WebSocket is down
SYNC_FALLBACK_POLL_MS=5000
# Admin backup: how often to check "did anything change?"
BACKUP_CHECK_INTERVAL_MS=120000
# Number of daily snapshot files to keep
BACKUP_DAILY_KEEP=30

