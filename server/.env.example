NODE_ENV=development
PORT=3000

# SQLite / Cloudflare D1 local database file URL for Prisma
DATABASE_URL="file:./dev.db"

# Cloudflare D1 Configuration (from Cloudflare Dashboard or `npx wrangler d1 create <name>`)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_D1_DATABASE_NAME=stockflow-db

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecretstockflowjwtkeychangeinprod1234567890
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
WS_PING_INTERVAL_MS=30000
LOG_LEVEL=info

# Seeding configuration
# Optional: specify a backup JSON file path to seed all inventory data directly
# e.g., BACKUP_FILE=./inventory-latest.json
BACKUP_FILE=

# Used by "npm run seed" when no backup file is provided
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-now
