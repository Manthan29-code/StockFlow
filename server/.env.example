NODE_ENV=development
PORT=3000

# Neon POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon DIRECT (non-pooled) connection string. Used only by Prisma migrations.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# Separate empty database/branch for tests (use the direct string). Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname_test?sslmode=require
# Max connections the app opens (keep small on the free tier)
DB_POOL_MAX=5

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=supersecretstockflowjwtkeychangeinprod1234567890
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15
WS_PING_INTERVAL_MS=30000
LOG_LEVEL=info

# used only by "npm run seed" to create the first admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-now

