generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("staff")
  isActive     Boolean  @default(true) @map("is_active")
  color        String   @default("#635BFF")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at")
  updatedBy    String?  @map("updated_by")
  version      Int      @default(1)

  @@map("users")
}

model Unit {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  createdBy String?    @map("created_by")
  updatedAt DateTime   @updatedAt @map("updated_at")
  updatedBy String?    @map("updated_by")
  version   Int        @default(1)
  materials Material[]

  @@map("units")
}

model Material {
  id              String                @id @default(uuid())
  name            String                @unique
  unitId          String                @map("unit_id")
  deductBy        String                @map("deduct_by")
  specLabel       String?               @map("spec_label")
  isActive        Boolean               @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime              @default(now()) @map("created_at")
  createdBy       String?               @map("created_by")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  updatedBy       String?               @map("updated_by")
  version         Int                   @default(1)
  unit            Unit                  @relation(fields: [unitId], references: [id])
  incomingEntries IncomingEntry[]
  bomLines        BomLine[]

  @@map("materials")
}

model IncomingEntry {
  id           String                @id @default(uuid())
  materialId   String                @map("material_id")
  inDate       DateTime              @db.Date @map("in_date")
  challanNo    String                @map("challan_no")
  quantity     Decimal               @db.Decimal(14, 3)
  supplier     String?
  notes        String?
  lockSeq      Int                   @default(0) @map("lock_seq")
  createdAt    DateTime              @default(now()) @map("created_at")
  createdBy    String?               @map("created_by")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  updatedBy    String?               @map("updated_by")
  version      Int                   @default(1)
  material     Material              @relation(fields: [materialId], references: [id])
  outgoingRows OutgoingTransaction[]

  @@map("incoming_entries")
}

model OutgoingTransaction {
  id              String        @id @default(uuid())
  incomingEntryId String        @map("incoming_entry_id")
  outDate         DateTime      @db.Date @map("out_date")
  challanNo       String        @map("challan_no")
  rowNo           Int           @map("row_no")
  qty             Decimal       @db.Decimal(14, 3)
  pieceWeight     Decimal?      @db.Decimal(12, 4) @map("piece_weight")
  specValue       String?       @map("spec_value")
  totalWeight     Decimal?      @db.Decimal(14, 3) @map("total_weight")
  deducted        Decimal       @db.Decimal(14, 3)
  createdAt       DateTime      @default(now()) @map("created_at")
  createdBy       String?       @map("created_by")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  updatedBy       String?       @map("updated_by")
  version         Int           @default(1)
  incomingEntry   IncomingEntry @relation(fields: [incomingEntryId], references: [id], onDelete: Cascade)

  @@map("outgoing_transactions")
}

model Party {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  version   Int       @default(1)
  products  Product[]

  @@map("parties")
}

model Product {
  id        String    @id @default(uuid())
  partyId   String    @map("party_id")
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")
  version   Int       @default(1)
  party     Party     @relation(fields: [partyId], references: [id])
  bomLines  BomLine[]

  @@unique([partyId, name])
  @@map("products")
}

model BomLine {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  materialId  String   @map("material_id")
  consumption Decimal  @db.Decimal(14, 3)
  specValue   String?  @map("spec_value")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")
  version     Int      @default(1)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [materialId], references: [id])

  @@map("bom_lines")
}

model AuditLog {
  id       String   @id @default(uuid())
  userId   String?  @map("user_id")
  action   String
  entity   String
  entityId String?  @map("entity_id")
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@map("audit_log")
}

model Meta {
  key   String @id
  value String

  @@map("meta")
}

